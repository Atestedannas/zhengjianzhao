# ============================================================
# 照片合规处理系统 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# 注意: .env 文件包含敏感信息，不要提交到版本控制
# ============================================================

# ======================== 应用 ========================
APP_NAME=PhotoService
APP_ENV=development               # 环境: development | staging | production
DEBUG=true                        # 是否开启调试模式（生产环境务必设为 false）
API_V1_PREFIX=/api/v1

# ======================== 数据库 (MySQL 8.0) ========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=photo_app
DB_PASSWORD=your_db_password_here # 替换为实际数据库密码
DB_NAME=photo_service
DB_POOL_SIZE=10                   # 连接池大小
DB_MAX_OVERFLOW=20                # 连接池溢出上限

# **开发环境** — 如果使用 docker-compose 启动 MySQL，host 改为 mysql
# DB_HOST=mysql

# **生产环境** — 建议使用 .env.production 独立文件
# DB_HOST=your-rds-endpoint.rds.aliyuncs.com
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40

# ======================== Redis ========================
REDIS_URL=redis://127.0.0.1:6379/0

# **开发环境 Docker** — 使用 docker-compose 中的 Redis 服务名
# REDIS_URL=redis://redis:6379/0

# **生产环境** — 使用 Redis 集群或云 Redis
# REDIS_URL=redis://:password@your-redis-host:6379/0

# ======================== JWT 鉴权 ========================
JWT_SECRET_KEY=change_me_to_a_random_64_char_string  # 务必修改！生成命令: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120                       # Access Token 有效期（分钟）
REFRESH_TOKEN_EXPIRE_DAYS=7                           # Refresh Token 有效期（天）

# PC 端（/web-pc/）密码登录用的访问密码。
# 留空或缺失时 /api/v1/auth/web-login 会直接返回 503，前端表现为“登录失败”。
WEB_LOGIN_PASSWORD=change_me_to_a_strong_password     # 务必修改！

# ======================== 微信开放平台 ========================
# 微信小程序配置（用户端）
WECHAT_MINI_APPID=wx_your_mini_app_id                 # 替换为小程序 AppID
WECHAT_MINI_SECRET=your_mini_app_secret               # 替换为小程序 AppSecret

# 微信开放平台 Web 应用配置（扫码登录）
WECHAT_WEB_APPID=wx_your_web_app_id                   # 替换为 Web 应用 AppID
WECHAT_WEB_SECRET=your_web_app_secret                 # 替换为 Web 应用 AppSecret

# ======================== PC 端扫码登录回调 ========================
# 站点对外地址：留空则必须显式配置下面两个回调地址，否则扫码登录接口返回 503
PUBLIC_BASE_URL=http://your-domain.com                # 例: https://photo.example.com
# 也可以单独指定，必须与平台后台登记的回调地址完全一致
# WECHAT_WEB_REDIRECT_URI=https://photo.example.com/web-pc/oauth/callback
# ALIPAY_REDIRECT_URI=https://photo.example.com/web-pc/oauth/callback

# ======================== 微信支付 (V3 API) ========================
WECHAT_MCH_ID=1234567890                              # 商户号
WECHAT_API_V3_KEY=your_api_v3_key                     # APIv3 密钥（32位）
WECHAT_PRIVATE_KEY_PATH=/etc/secrets/apiclient_key.pem # 商户私钥路径
WECHAT_CERT_SERIAL_NO=your_cert_serial                # 证书序列号
WECHAT_NOTIFY_URL=https://your-domain.com/api/v1/payment/wechat-notify  # 支付回调地址

# 微信支付目前仅支持 JSAPI（小程序）和 Native（扫码）两种方式
# 如需开通其他支付方式，请在微信支付商户平台配置

# ======================== 支付宝支付 ========================
ALIPAY_APP_ID=2021xxxxxxxxxxxx                        # 支付宝应用 ID
ALIPAY_PRIVATE_KEY_PATH=/etc/secrets/alipay_private_key.pem  # 应用私钥路径
ALIPAY_PUBLIC_KEY_PATH=/etc/secrets/alipay_public_key.pem    # 支付宝公钥路径
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payment/alipay-notify  # 支付回调地址
ALIPAY_RETURN_URL=https://your-domain.com/pay-result  # 支付完成跳转地址

# 支付宝沙箱环境（测试用）
# ALIPAY_APP_ID=902100013xxxxxxx
# ALIPAY_NOTIFY_URL=https://your-test-domain.com/api/v1/payment/alipay-notify
# 沙箱网关地址自动切换，无需手动配置

# ======================== 文件上传 ========================
UPLOAD_MAX_MB=10                    # 最大上传文件大小（MB）
TEMP_FILE_DIR=/data/temp            # 临时文件存储目录
TEMP_FILE_TTL_MINUTES=5             # 临时文件过期时间（分钟）

# ======================== 异步处理任务（Celery） ========================
# /api/v1/process/ 只做「校验 + 扣费 + 建记录 + 投递任务」，出图由 celery-worker 完成，
# 前端轮询 /api/v1/process/{id}/status 拿结果。
# 原图暂存目录：必须是 backend 与 celery-worker **共享的卷**
# （默认在 TEMP_FILE_DIR 下的子目录；子目录不会被 cleanup_expired_files 的非递归 glob 清掉）
PROCESS_PENDING_DIR=/data/temp/pending
# 任务失败自动重试次数（0=不重试）。只针对基础设施异常（如数据库不可用），
# 图像处理本身的失败会直接落库并退还次数，不重试。
PROCESS_TASK_MAX_RETRIES=1
# 记录卡在 pending/processing 超过该分钟数，视为 worker 中途死亡（例如被内核 OOM 杀掉），
# 由定时兜底任务判失败并退还免费次数，避免用户一直转圈
PROCESS_STUCK_MINUTES=15

# ======================== 限流 ========================
RATE_LIMIT_PER_MINUTE=60            # 单 IP 每分钟 API 请求数上限

# ======================== AI 抠图（内存治理的关键开关） ========================
# BiRefNet 的 ONNX 输入是导出时写死的 1x3x1024x1024，不能降分辨率推理，
# 单次推理峰值实测 >3GB；4GB 以下的小机器会被内核 OOM 杀掉（表现：nginx 502、
# gunicorn 日志出现 "Worker was sent SIGKILL"）。
# 模型文件随镜像打进容器（BiRefNet 在 /app/models，u2net 系列在 /root/.u2net），
# 运行时不会联网下载。
#   auto     = 按当前可用内存自动选（默认；内存不够就退回轻量模型，不冒 OOM 风险）
#   birefnet = 强制 BiRefNet（质量最好，建议可用内存 ≥4GB）
#   u2net    = 强制 u2net_human_seg（输入 320x320，峰值几百 MB，发丝细节略差）
#   off      = 不做 AI 抠图（等价于保持原背景）
BG_ENGINE=auto
# auto 模式下，可用内存低于该值（MB）就退回轻量模型
BIREFNET_MIN_AVAILABLE_MB=3600
# onnxruntime 算子内并行线程数；0 = 自动（min(4, CPU 核数)）
ORT_INTRA_OP_THREADS=0

# ======================== 日志 ========================
# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# 日志格式: json | text
LOG_FORMAT=json

# ======================== 维护模式 ========================
# 开启后所有 API 返回 503，管理后台不受影响
MAINTENANCE_MODE=false

# ======================== Docker 部署专用 ========================
# 仅在使用 docker-compose 部署时需要设置
DB_ROOT_PASSWORD=your_root_password_here
DB_PASSWORD=your_db_password_here